{
  "id": "/leadlive",
  "name": "Casa Mancini · לידים",
  "short_name": "לידים",
  "description": "מערכת הלידים של Casa Mancini",
  "lang": "he",
  "dir": "rtl",
  "start_url": "/leadlive",
  "scope": "/leadlive",
  "display": "standalone",
  "background_color": "#faf9f6",
  "theme_color": "#faf9f6",
  "icons": [
    {
      "src": "/leadlive/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/leadlive/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/leadlive/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
